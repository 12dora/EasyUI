{
  "name": "@easy-enterprise/ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.2.2",
  "sideEffects": [
    "**/*.css",
    "./src/toast.ts",
    "./src/primitives/dialog.tsx",
    "./src/primitives/unsaved-changes.tsx"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./motion": "./src/motion.ts",
    "./toast": "./src/toast.ts",
    "./control-tokens": "./src/control-tokens.ts",
    "./primitives": "./src/primitives/index.ts",
    "./primitives/*": "./src/primitives/*.tsx",
    "./shell": "./src/shell/index.ts",
    "./table": "./src/table/index.ts",
    "./table.css": "./src/table/table.css",
    "./enterprise": "./src/enterprise/index.ts",
    "./enterprise-local-accounts": "./src/enterprise-local-accounts/index.tsx",
    "./eslint-smells": "./eslint.smells.config.mjs"
  },
  "bin": {
    "easyui-check-smells": "./scripts/check-smells.mjs"
  },
  "dependencies": {
    "dayjs": "^1.11.11",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "antd": "^6.5.2",
    "eslint": ">=9",
    "motion": ">=12",
    "react": ">=19",
    "react-dom": ">=19",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "antd": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "antd": "6.5.2",
    "eslint": "9.39.4",
    "happy-dom": "^20.11.2",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "node ./scripts/check-smells.mjs --config eslint.config.mjs --targets src scripts --baseline .code-smells-baseline.json"
  }
}
